{
  "name": "inkchain-docs",
  "volta": {
    "node": "22.23.4",
    "pnpm": "9.12.3"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "next-sitemap",
    "start": "next start",
    "lint": "pnpm run lint:js && pnpm run lint:mdx && pnpm run format:js:check && pnpm run spellcheck:lint",
    "lint:fix": "pnpm run lint:js:fix && pnpm run lint:mdx:fix && pnpm run format:js && pnpm run spellcheck:fix",
    "lint:js": "eslint ./src theme.config.tsx --ext js,jsx,ts,tsx",
    "lint:js:fix": "eslint ./src theme.config.tsx --fix --ext js,jsx,ts,tsx",
    "format:js": "prettier --write \"**/*.{ts,tsx,css,scss}\"",
    "format:js:check": "prettier --check \"**/*.{ts,tsx,css,scss}\"",
    "lint:mdx": "remark . --quiet --frail",
    "lint:mdx:fix": "remark . -o --quiet",
    "spellcheck:lint": "cspell lint \"**/*.mdx\"",
    "spellcheck:fix": "cspell --words-only --unique \"**/*.mdx\" | sort --ignore-case | uniq"
  },
  "remarkConfig": {
    "settings": {
      "emphasis": "*",
      "strong": "*"
    },
    "plugins": [
      "remark-frontmatter",
      "remark-preset-lint-consistent",
      "remark-preset-lint-recommended",
      "remark-gfm",
      [
        "remark-mdx",
        {
          "commonmark": true,
          "extensions": [
            ".mdx"
          ],
          "jsx": true
        }
      ],
      "remark-lint-frontmatter-schema",
      "remark-lint-heading-style",
      "remark-lint-list-item-indent",
      "remark-lint-table-cell-padding",
      "remark-lint-table-pipe-alignment",
      "remark-lint-table-pipes",
      "remark-lint-unordered-list-marker-style"
    ]
  },
  "dependencies": {
    "clsx": "2.1.1",
    "next": "16.4.1",
    "next-sitemap": "4.2.3",
    "next-themes": "0.4.6",
    "nextra": "3.3.1",
    "nextra-theme-docs": "3.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.1.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.21",
    "cspell": "9.2.0",
    "eslint": "9.32.0",
    "eslint-config-next": "16.4.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-mdx": "3.6.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "mdx": "0.3.1",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "remark": "15.0.1",
    "remark-cli": "12.0.1",
    "remark-code-import": "1.2.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-lint-frontmatter-schema": "3.15.4",
    "remark-lint-heading-style": "4.0.1",
    "remark-lint-list-item-indent": "4.0.1",
    "remark-lint-table-cell-padding": "5.1.1",
    "remark-lint-table-pipe-alignment": "4.1.1",
    "remark-lint-table-pipes": "5.0.1",
    "remark-lint-unordered-list-marker-style": "4.0.1",
    "remark-mdx": "3.1.0",
    "remark-preset-lint-consistent": "6.0.1",
    "remark-preset-lint-recommended": "7.0.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  },
  "pnpm": {
    "patchedDependencies": {
      "nextra@3.3.1": "patches/nextra@3.3.1.patch"
    },
    "overrides": {
      "@apidevtools/json-schema-ref-parser": "^11.2.0",
      "@xmldom/xmldom": "^0.9.11",
      "brace-expansion@<1.1.16": "^1.1.16",
      "brace-expansion@>=2.0.0 <2.1.2": "^2.1.2",
      "browserslist": "^4.28.7",
      "dompurify": "^3.4.17",
      "flatted": "^3.4.2",
      "glob@<10.5.0": "^10.5.0",
      "js-yaml@<3.15.0": "^3.15.0",
      "js-yaml@>=4.0.0 <4.3.0": "^4.3.0",
      "lodash-es": "^4.18.0",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "nanoid": "^3.3.18",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss": "^8.5.30",
      "smol-toml": "^1.7.1",
      "source-map-js": "^1.2.2",
      "trim-newlines": "^3.0.1"
    }
  }
}
